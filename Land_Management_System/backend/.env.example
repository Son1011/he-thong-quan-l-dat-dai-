# Environment Configuration for Land Management System Backend

# ============================================
# JWT Configuration
# ============================================
# IMPORTANT: Change this in production!
# Generate a secure random key (min 32 characters)
# Example: openssl rand -base64 32
JWT_SECRET=dev-secret-change-me-in-production-very-important-key-for-security

# ============================================
# File Upload Configuration
# ============================================
# Directory where uploaded files will be stored
UPLOADS_DIR=./data/uploads

# Maximum file size in bytes (50 MB)
MAX_FILE_SIZE=52428800

# ============================================
# Database Configuration
# ============================================
# Database connection URL
# DB_URL=jdbc:mysql://localhost:3306/land_mgmt

# Database username
# DB_USERNAME=root

# Database password
# DB_PASSWORD=root

# ============================================
# Application Configuration
# ============================================
# Application port
SERVER_PORT=8080

# Logging level (DEBUG, INFO, WARN, ERROR)
LOGGING_LEVEL=DEBUG

# ============================================
# Production Recommendations
# ============================================
# 1. NEVER commit actual credentials to version control
# 2. Use secure vault/secret management in production
# 3. Generate strong JWT_SECRET with: openssl rand -base64 32
# 4. Use HTTPS in production
# 5. Set LOGGING_LEVEL to INFO in production
# 6. Keep backups of database credentials
# 7. Monitor audit logs for suspicious activities
